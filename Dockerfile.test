FROM node:20-alpine
WORKDIR /app

RUN apk add --no-cache chromium

ENV CHROME_BIN=/usr/bin/chromium-browser
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Push schema to test DB then run tests
CMD ["sh", "-c", "npx drizzle-kit push && npx vitest run && npx playwright test --reporter=list"]
